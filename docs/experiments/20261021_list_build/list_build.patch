+                    if ((mask & (1u << i)) == 0) continue;
+                    if (at < list_cap) block_list[at] = (q << 3) | (uint32_t)i;
+                    at++;
+                }
+            }
+        } else {
+            for (uint32_t b = tx; b < nb; b += BLOCK_SIZE) {

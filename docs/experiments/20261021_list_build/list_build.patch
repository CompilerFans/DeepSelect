+        // A uint4 carries eight maxima and reserves the vector's kept count in
+        // one atomic: measured 1.67x the scalar loop at BLOCK 1024 and 1.75x
+        // at 512, while ballot compaction measured *slower* than the per-block
+        // atomics (docs/experiments/20261021_list_build/).  The vector arm
+        // needs whole vectors and a 16-B-aligned row table (the row stride is
+        // `blocks_per_row * 2` bytes, odd when the stride is odd); anything
+        // else keeps the scalar loop unchanged.
+        const bool list_vec =
+            (nb & 7u) == 0 &&
+            (reinterpret_cast<uintptr_t>(block_max) & (sizeof(uint4) - 1u)) == 0;
+        if (list_vec) {
+            const uint4* bm4 = reinterpret_cast<const uint4*>(block_max);
+            const uint32_t n4 = nb >> 3;

 constexpr uint32_t kSkipBlockElems = 64;
 
+// ── the one-pass row: a running threshold, no histogram ────────────────────
+// docs/experiments/20261020_onepass/ has the probe and the design.  Elements
+// above the running threshold stage into the arena; when the count crosses
+// `topk + kOnePassB2` the CTA compacts -- it selects the exact top-k of
+// (survivors ∪ arena), raises the threshold to their k-th, and drops the
+// rest.  The survivors live in `output` (the contract's staging buffer)
+// between compacts, the arena is scratch, and the compact's gather goes to
+// the arena front and is then copied to `output`, so no region is read and
+// written at once.  Every element is read from DRAM exactly once, and the
+// shared atomics fire only on candidates (~k·ln(L/B) per row) -- which is
+// what moves the 28/32-AP parts off the per-element atomic issue ceiling
+// that caps the two-pass row near half the wall.
+//
+// The invariant (upstream's): an element dropped at a compact is below at
+// least k elements of the same row at that moment, so it can never be in the
+// row's top-k; the threshold only rises.  A row whose count never reaches
+// `topk` (every element key == 0) is a row of negative NaNs -- the only
+// zero-key encoding -- and is answered by the NaN disposition, never by this
+// select.
+constexpr uint32_t kOnePassB2 = 512;
+
+// The arena's entries: `topk + B2` for the compact trigger, plus one vote
+// period of staging.  The vote is per outer iteration, whose work is
+// `2 * BLOCK_SIZE * 8` elements (two blocks per 8-lane group).
+template <uint32_t BLOCK_SIZE>
+constexpr uint32_t onepass_arena_entries(uint32_t topk) {
+    return topk + kOnePassB2 + 2 * BLOCK_SIZE * 8;
+}
+
+// The host-visible half of the gate (the device adds alignment and the
+// per-row window): 128 KiB-smem families, long rows, the swept k set.
+constexpr bool onepass_shape_applies(uint32_t vocab_size, uint32_t topk) {
+    return ARCH_SMEM_PER_AP_BYTES >= 128 * 1024 && vocab_size >= 65536 &&
+           (topk == 512 || topk == 1024 || topk == 2048);
+}
+
+template <uint32_t BLOCK_SIZE, bool kNan = false>
+__device__ __forceinline__ void radix_topk_row_bf16_onepass(
+    const maca_bfloat16* input, int32_t* output, uint32_t length, uint32_t topk,
+    bool* row_nan, int32_t* arena)
+{
+    constexpr uint32_t RADIX = kRadix;
+    const uint32_t cap = topk + kOnePassB2 + 2 * BLOCK_SIZE * 8;
+    __shared__ uint32_t s_count;
+    __shared__ uint32_t s_thresh;
+    __shared__ uint32_t s_new;
+    __shared__ int32_t s_tie;
+    __shared__ uint32_t s_nsurv;
+    __shared__ uint32_t s_pick;
+    __shared__ uint32_t s_histogram_buf[2][RADIX + 32];
+    auto& s_hist = s_histogram_buf[0];
+    const uint32_t tx = threadIdx.x;
+    if (tx == 0) { s_count = 0; s_thresh = 0; s_nsurv = 0; }
+    __syncthreads();
+
+    // The compact: exact top-k of output[0..s_nsurv) U arena[0..s_count),
+    // threshold to the k-th, survivors rewritten to the arena front and then
+    // copied back to output (unordered output is the contract's own form).
+    const auto compact = [&] {
+        const uint32_t ns = s_nsurv;
+        const uint32_t m = s_count;
+        uint32_t prefix = 0, prefix_keep = 0;
+        #pragma unroll
+        for (int round = 0; round < 2; round++) {
+            const uint32_t shift = round == 0 ? 8 : 0;
+            if (tx < RADIX + 1) s_hist[tx] = 0;
+            __syncthreads();
+            for (uint32_t i = tx; i < ns; i += BLOCK_SIZE) {
+                const uint32_t key = refine_bin(__ldg(input + output[i]));
+                if (round == 0 || (key >> 8) == prefix)
+                    atomicAdd(&s_hist[(key >> shift) & 0xFFu], 1u);
+            }
+            for (uint32_t i = tx; i < m; i += BLOCK_SIZE) {
+                const uint32_t key = refine_bin(__ldg(input + arena[i]));
+                if (round == 0 || (key >> 8) == prefix)
+                    atomicAdd(&s_hist[(key >> shift) & 0xFFu], 1u);
+            }
+            __syncthreads();
+            uint32_t exclusive_suffix = 0;
+            const uint32_t inclusive_suffix =
+                run_cumsum_warp(s_histogram_buf, tx, exclusive_suffix);
+            const uint32_t need = topk - prefix_keep;
+            if (tx < RADIX && inclusive_suffix >= need && exclusive_suffix < need)
+                s_pick = tx;
+            __syncthreads();
+            if (round == 0) {
+                prefix = s_pick;
+                prefix_keep = s_hist[s_pick + 1];
+            } else {
+                prefix = (prefix << 8) | s_pick;
+                prefix_keep += s_hist[s_pick + 1];
+            }
+            // The pick's reads of `s_hist` are not barriered against the next
+            // round's zeroing without this -- a fast thread may zero a bin a
+            // slow one has not read yet, and `prefix_keep` then comes out
+            // short (the first draft's dropped-candidate race).
+            __syncthreads();
+        }
+        // prefix_keep is now count(key > T) exactly; ties owed the rest.
+        const uint32_t T = prefix;
+        if (tx == 0) { s_new = 0; s_tie = (int32_t)(topk - prefix_keep); }
+        __syncthreads();
+        // The gather writes survivors to the arena it also reads, so the
+        // arena's content is first snapshotted to registers -- a read-through
+        // would race with the unordered atomic positions (this was the
+        // first draft's duplicate bug, measured).
+        int32_t snap[(2048 + kOnePassB2 + 2 * BLOCK_SIZE * 8) / BLOCK_SIZE];
+        const uint32_t rounds = (m + BLOCK_SIZE - 1) / BLOCK_SIZE;
+        for (uint32_t r = 0; r < rounds; r++) {
+            const uint32_t i = tx + r * BLOCK_SIZE;
+            if (i < m) snap[r] = arena[i];
+        }
+        __syncthreads();
+        const auto keep = [&](int32_t idx) {
+            const uint32_t key = refine_bin(__ldg(input + idx));
+            if (key > T) {
+                arena[atomicAdd(&s_new, 1u)] = idx;
+            } else if (key == T) {
+                const int p = atomicAdd(&s_tie, -1);
+                if (p > 0) arena[atomicAdd(&s_new, 1u)] = idx;
+            }
+        };
+        for (uint32_t i = tx; i < ns; i += BLOCK_SIZE) keep(output[i]);
+        for (uint32_t r = 0; r < rounds; r++) {
+            const uint32_t i = tx + r * BLOCK_SIZE;
+            if (i < m) keep(snap[r]);
+        }
+        __syncthreads();
+        for (uint32_t i = tx; i < topk; i += BLOCK_SIZE) output[i] = arena[i];
+        if (tx == 0) { s_nsurv = topk; s_count = 0; s_thresh = T; }
+        __syncthreads();
+    };
+
+    bool nan_local = false;
+    const uint32_t vec_len = length / 8 * 8;
+    const uint32_t nblk = vec_len >> 6;
+    const uint32_t group = tx >> 3, lane = tx & 7u;
+    const uint32_t step = BLOCK_SIZE / 8;
+    for (uint32_t it = 0; it * step < nblk; it += 2) {
+        const uint32_t T = s_thresh;   // one smem read per iteration
+        #pragma unroll
+        for (int half = 0; half < 2; half++) {
+            const uint32_t blk = group + (it + half) * step;
+            if (((blk + 1u) << 6) > vec_len) continue;
+            const uint4 v = __ldg(
+                reinterpret_cast<const uint4*>(input + (blk << 6) + lane * 8u));
+            const uint32_t* w = reinterpret_cast<const uint32_t*>(&v);
+            uint32_t z = 0;
+            #pragma unroll
+            for (int i = 0; i < 4; i++) {
+                const uint32_t kp =
+                    w[i] ^ ((((w[i] >> 15) & 0x00010001u) * 0x7FFFu) + 0x80008000u);
+                const uint32_t lo = kp & 0xFFFFu, hi = kp >> 16;
+                if (lo > T) {
+                    const uint32_t pos = atomicAdd(&s_count, 1u);
+                    if (pos < cap) arena[pos] = (blk << 6) + lane * 8u + 2u * i;
+                }
+                if (hi > T) {
+                    const uint32_t pos = atomicAdd(&s_count, 1u);
+                    if (pos < cap) arena[pos] = (blk << 6) + lane * 8u + 2u * i + 1u;
+                }
+                if (kNan)
+                    z |= (((w[i] & 0x7FFF7FFFu) | 0x80008000u) - 0x7F817F81u)
+                         & 0x80008000u;
+            }
+            nan_local |= (z != 0u);
+        }
+        if (__syncthreads_or(s_count >= topk + kOnePassB2)) compact();
+    }
+    // The scalar tail of the row, on the same terms.
+    for (uint32_t idx = (nblk << 6) + tx; idx < length; idx += BLOCK_SIZE) {
+        const maca_bfloat16 raw = __ldg(input + idx);
+        if (refine_bin(raw) > s_thresh) {
+            const uint32_t pos = atomicAdd(&s_count, 1u);
+            if (pos < cap) arena[pos] = idx;
+        }
+        if (kNan) nan_local |= bf16_is_nan(__bfloat16_as_ushort(raw));
+    }
+    __syncthreads();
+    if (s_count > 0) compact();
+    if (kNan && row_nan != nullptr)
+        *row_nan = __syncthreads_or((int)nan_local) != 0;
+}

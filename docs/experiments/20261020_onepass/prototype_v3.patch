+// the compact's per-index DRAM gathers were the whole cost.  The arena now
+// carries a 16-bit key sidecar written at stage time, so every histogram
+// round reads smem; the survivors' keys ride a second small sidecar; and the
+// gather goes to the arena TAIL under a disjointness bound instead of
+// snapshotting to registers (v1's two fixes are documented in place).
+//
+// Overlap safety of the backward gather: the write region is [cap - topk,
+// cap), the read region [0, m), and the vote fires at `s_count >= topk + B2`
+// with at most one slack period of staging past it, so m <= B2 - 1 + slack
+// <= cap - topk by construction of `cap`.
+template <uint32_t BLOCK_SIZE, bool kNan = false>
+__device__ __forceinline__ void radix_topk_row_bf16_onepass(
+    const maca_bfloat16* input, int32_t* output, uint32_t length, uint32_t topk,
+    bool* row_nan, int32_t* arena, uint16_t* arena_key, uint16_t* output_key)
+{
+    constexpr uint32_t RADIX = kRadix;
+    const uint32_t slack = onepass_slack(topk);
+    const uint32_t cap = topk + kOnePassB2 + slack;
+    __shared__ uint32_t s_count;
+    __shared__ uint32_t s_thresh;
+    __shared__ int32_t s_back;
+    __shared__ int32_t s_tie;
+    __shared__ uint32_t s_nsurv;
+    __shared__ uint32_t s_pick;
+    __shared__ uint32_t s_histogram_buf[2][RADIX + 32];
+    auto& s_hist = s_histogram_buf[0];
+    const uint32_t tx = threadIdx.x;
+    if (tx == 0) { s_count = 0; s_thresh = 0; s_nsurv = 0; }
